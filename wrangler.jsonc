{
  "name": "myhabbit",
  "main": "./src/worker.js",
  "workers_dev": true,
  "vars": {
    "TELEGRAM_BOT_USERNAME": "",
    "OWNER_MAX_FAMILIES": "50"
  },
  "compatibility_date": "2026-07-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*", "/owner-console", "/owner-console/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_STATE",
        "class_name": "TelegramStateV2"
      }
    ]
  },
  "exports": {
    "TelegramStateV2": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true
}
